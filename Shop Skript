# Netherite Sword Upgrade
on inventory click:
    if name of player's open inventory contains "&5More Items":
        cancel event
        if clicked slot is 12:
            set {_sword1buy} to chest inventory with 5 rows named "&7Buy &7Sword &5Upgrade?"
            open {_sword1buy} to player
            set slot 13 of {_sword1buy} to netherite sword named "&7Buy &7Sword &5Upgrade?" with lore "&c- &7Sharpness &c2"
            set slot 30 of {_sword1buy} to red stained glass pane named "&cCancel"
            set slot 32 of {_sword1buy} to lime stained glass pane named "&aConfirm"

on inventory click:
    if name of event-inventory contains "&7Buy &7Sword &5Upgrade?":
        cancel event

        if clicked slot is 30:
            close player's inventory

# Anywhere where it states {rubies.%player%} can be changed to your server's currency, and replaced by the variable in line 3, just ensure to change the variable where ever it is located in the code.

        if clicked slot is 32:
            if {rubies.%player%} >= 75000:
                remove 75000 from {rubies.%player%}
                give player unbreakable netherite sword of sharpness 2 named "&7Tier &5&l5 &7Sword Upgrade"
                send "&aPurchase Successful" to player
            else:
                send "&cYou do not have enough rubies to purchase this."
                close player's inventory

