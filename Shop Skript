command /shop:
    trigger:
        open chest inventory with 3 rows named "&aSelect Shop" to player
        set slot 12 of player's open inventory to cobweb named "&b&lItems"
        set slot 14 of player's open inventory to bow named "&5&l&oMore Weapons"

# You can change the items in the shop and their prices by editing the code below. Just make sure to keep the structure of the code the same, otherwise it may not work properly.
# Anything you see surrounded by {} is a variable and can be changed to fit your server's needs, just ensure to change the variable where ever it is located in the code.

on inventory click:
    if name of player's open inventory is "&aSelect Shop":
        cancel event
        if clicked slot is 12:
            open chest inventory with 5 rows named "&bItems" to player
            set slot 0 of player's open inventory to 4 cobweb with lore "&eᴄᴏsᴛ: &c750 &7Rubies" and "&5&oWebs disappear after 5 seconds!"
            set slot 1 of player's open inventory to 8 golden apple with lore "&eᴄᴏsᴛ: &c248 &7Rubies"
            set slot 2 of player's open inventory to splash potion of instant health with lore "&eᴄᴏsᴛ: &c3,000 &7Rubies"
            set slot 3 of player's open inventory to 16 arrow with lore "&eᴄᴏsᴛ: &c100 &7Rubies"
            set slot 4 of player's open inventory to fishing rod with lore "&eᴄᴏsᴛ: &c5,000 &7Rubies"
            set slot 5 of player's open inventory to bow with lore "&eᴄᴏsᴛ: &c3,000 &7Rubies"
            set slot 6 of player's open inventory to shield with lore "&eᴄᴏsᴛ: &c500 &7Rubies" and "&c- &7ʙʀᴇᴀᴋᴀʙʟᴇ!"
            set slot 7 of player's open inventory to netherite spear with lore "&eᴄᴏsᴛ: &c30,000 &7Rubies" and "&c- &7ʟᴜɴɢᴇ &cɪ" and "&c- &7ᴜɴʙʀᴇᴀᴋɪɴɢ &cɪ" and "&c- &7ʙʀᴇᴀᴋᴀʙʟᴇ!"
            set slot 8 of player's open inventory to 16 golden carrot with lore "&eᴄᴏsᴛ: &c480 &&Rubies"

# This part of the code is for the "More Weapons" shop, you can change the items and their prices by editing the code below, just make sure to keep the structure of the code the same, otherwise it may not work properly.

        if clicked slot is 14:
            open chest inventory with 3 rows named "&5More Items" to player
            set slot 11 of player's open inventory to turtle helmet named "&7Tier &a&l1 &7Turtle Shell" with lore "&eᴄᴏsᴛ: &c80,000 &7Rubies" and " " and "&c- &7ᴘʀᴏᴛᴇᴄᴛɪᴏɴ &cɪɪɪ" and "&c- &7ᴛʜᴏʀɴs &cɪ"
            set slot 12 of player's open inventory to netherite sword named "&7Tier &5&l5 &7Sword Upgrade" with lore "&eᴄᴏsᴛ: &c75,000 &7Rubies" and " " and "&c- &7sʜᴀʀᴘɴᴇss &cɪɪ"
            set slot 13 of player's open inventory to netherite axe named "&7Tier &5&l5 &7Axe Upgrade" with lore "&eᴄᴏsᴛ: &c50,000 &7Rubies" and " " and "&c- &7sʜᴀʀᴘɴᴇss &cɪɪ"
            set slot 14 of player's open inventory to crossbow named "&7Tier &f&l1 &7Crossbow" with lore "&eᴄᴏsᴛ: &c45,000 &7Rubies" and " " and "&c- &7ᴏ̨ᴜɪᴄᴋᴄʜᴀʀɢᴇ &cɪɪ" and "&c- &7ᴘɪᴇʀᴄɪɴɢ &cɪ"
            set slot 15 of player's open inventory to shield named "&7Unbreakable Shield" with lore "&eᴄᴏsᴛ: &c15,000 &7Rubies" and "&c- &7ᴜɴʙʀᴇᴀᴋᴀʙʟᴇ!"
